# Ambiente per il server MCP mem0 su Windows

# Embedder: istanza llama.cpp (Vulkan) con GGUF EmbeddingGemma, endpoint OpenAI-compatible
EMBED_BASE_URL=http://127.0.0.1:8084/v1
EMBED_MODEL=embeddinggemma-300M

# LLM per l'estrazione dei fatti: DeepSeek
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Vector store: Qdrant in Docker
QDRANT_HOST=127.0.0.1
QDRANT_PORT=7333
COLLECTION_NAME=mem0_memories

# Varie
MEM0_USER_ID=opencode
MEM0_DATA_DIR=C:\mem0\mem0_data
MEM0_HOST=127.0.0.1
MEM0_PORT=8090
